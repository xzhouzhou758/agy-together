[Unit]
Description=AGY Together shared browser helper (starts/stops the agy-browser container)
After=docker.service
Requires=docker.service

[Service]
EnvironmentFile=/opt/agy-pot/browserd.env
ExecStart=/usr/bin/python3 /opt/agy-pot/browserd.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
