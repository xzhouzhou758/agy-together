# /opt/agy-pot/portal.env  (chmod 600, root only)
# CLIProxyAPI: keys come from /opt/cliproxyapi/config.yaml
CPA_URL=http://127.0.0.1:8317
CPA_API_KEY=
CPA_MANAGEMENT_KEY=
# Cookies: keep 1 behind HTTPS
COOKIE_SECURE=1
# AI Studio pool (aistudio-pg-bridge relay). Leave the key empty to hide the feature.
AISTUDIO_RELAY_URL=http://127.0.0.1:18802
AISTUDIO_RELAY_KEY=
AISTUDIO_RECHECK_MINUTES=60
# Optional: Discord settings can instead be entered on /setup and the admin page
# PUBLIC_URL=https://pot.example.com
# ADMIN_DISCORD_IDS=
# Tests only, never in production:
# DEV_LOGIN=1
# Shared remote browser (ops/browserd.py). Same token as BROWSERD_TOKEN in /opt/agy-pot/browserd.env; empty hides the feature.
BROWSERD_URL=http://127.0.0.1:8330
BROWSERD_TOKEN=
BROWSER_UPSTREAM=http://127.0.0.1:3010
BROWSER_SESSION_MINUTES=15
